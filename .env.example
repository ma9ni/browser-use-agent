# ============================================================
# Configuration de l'agent Browser-Use
# ============================================================

# Option 1: Google Gemini (Recommandé, gratuit sur https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Option 2: OpenRouter (Gratuit avec les modèles :free sur https://openrouter.ai/keys)
USE_OPENROUTER=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Fichier de prompt par défaut (optionnel)
PROMPT_FILE=prompt.txt
